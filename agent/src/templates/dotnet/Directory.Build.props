<!-- ══════════════════════════════════════════════════════════════════════
     DO NOT MODIFY THIS FILE DURING FEATURE WORK
     aidw-template-version: 3
     ══════════════════════════════════════════════════════════════════════
     This file is shared across ALL projects under this directory and is intentionally
     immutable during feature development.
     Any modification requires:
       1. A dedicated maintenance PR (not part of a feature branch)
       2. Explicit justification in the PR description
       3. A full solution build + test pass before merge
     ══════════════════════════════════════════════════════════════════════ -->
<Project>

  <!-- ── Deployment ── -->
  <PropertyGroup>
    <ZipDeploymentWebRequestTimeout>600</ZipDeploymentWebRequestTimeout>
  </PropertyGroup>

  <!-- ── NuGet Audit ── -->
  <!-- Only HIGH and CRITICAL vulnerabilities are build-blocking; MODERATE findings from
       transitive dependencies are not merge-blockers by default. -->
  <PropertyGroup>
    <NuGetAuditLevel>high</NuGetAuditLevel>
  </PropertyGroup>

  <!-- ── Code Analysis ── -->
  <!-- AnalysisLevel=latest-recommended: balanced ruleset, avoids excessive noise on first pass. -->
  <!-- AnalysisModeSecurity=All: latest-recommended leaves most CA2xxx/CA3xxx/CA5xxx security rules
       OFF; this escalates the whole Security category to build-time diagnostics, which
       TreatWarningsAsErrors then makes build errors the rebuild loop must fix. This is the .NET
       side of the SAST story: the permissive semgrep rule packs carry no C# rules. -->
  <!-- EnforceCodeStyleInBuild: ensures .editorconfig style rules fire at build time, not just in IDE. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- ── Shared Analyzer Packages ── -->
  <!-- These are the external, deterministic signal this file exists for: every rule below is a
       compile error, not advice, so generated code that violates it cannot be handed back as
       "done" without the build failing first.
       PrivateAssets="all" keeps them build-only tools; they never become transitive dependencies.
       The condition excludes non-.csproj project types (e.g. legacy .sqlproj on ToolsVersion 4.0,
       which cannot consume analyzer packages at all). -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <!-- License: MIT — free open-source (Microsoft / dotnet/roslyn-analyzers); no commercial restrictions. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.300">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: Sonar Source-Available License v1.0 — free to use as a build-time analyzer in your own
         product; restricts use in tools that compete with SonarQube. NOT an OSI-approved open-source
         license. Not a paid/commercial license — no subscription required for this NuGet package. -->
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.27.0.140913">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: MIT — free open-source (Gérald Barré / meziantou); no commercial restrictions. -->
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.101">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: Apache-2.0 — free open-source (dotnet/roslynator); no commercial restrictions. -->
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: Apache-2.0 — free open-source (Semih Okur / semihokur/AsyncFixer); no commercial restrictions. -->
    <PackageReference Include="AsyncFixer" Version="2.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: MIT — free open-source (Microsoft / dotnet/roslyn); no commercial restrictions.
         Note: 4.14.0 is the NuGet-latest but was unlisted by the owner (possible deprecation); pinned to 3.3.4. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: MIT — free open-source (Microsoft / dotnet/vs-threading); no commercial restrictions.
         Catches async deadlock patterns (VSTHRD002 .Result/.Wait(), VSTHRD003 foreign tasks,
         VSTHRD100 async void, VSTHRD110 fire-and-forget, VSTHRD200 missing Async suffix) that
         complement AsyncFixer's own rules. -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: MIT — free open-source (Tom Englert); no commercial restrictions.
         Flags every use of the null-forgiving operator (!), so nullability suppressions have to be
         explicit rather than silently silencing the compiler. -->
    <PackageReference Include="Nullable.Extended.Analyzer" Version="1.15.6581">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
