{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureOpenAI": {
    "Endpoint": "",
    "AuthMode": "ApiKey",
    "SpecAgent": {
      "DeploymentName": "",
      "Temperature": 0.7,
      "MaxOutputTokens": 8192
    },
    "PlanAgent": {
      "DeploymentName": "",
      "Temperature": 0.5,
      "MaxOutputTokens": 8192
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Workflow": {
    "MaxGateIterations": 5
  }
}
