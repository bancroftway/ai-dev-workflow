<!-- ════════════════════════════════════════════════════════════════════════
     DO NOT MODIFY THIS FILE DURING FEATURE WORK
     ════════════════════════════════════════════════════════════════════════
     This file is shared across ALL projects in src/ and is intentionally
     immutable during feature development (see SKILL.md and tech-stack.md).
     Any modification requires:
       1. A dedicated maintenance PR (not part of a feature branch)
       2. Explicit justification in the PR description
       3. A full solution build + test pass before merge
     ════════════════════════════════════════════════════════════════════════ -->
<Project>

  <!-- ── Deployment ── -->
  <PropertyGroup>
    <ZipDeploymentWebRequestTimeout>600</ZipDeploymentWebRequestTimeout>
  </PropertyGroup>

  <!-- ── NuGet Audit ── -->
  <!-- Align with tech-stack.md policy: only HIGH and CRITICAL vulnerabilities are build-blocking.
       MODERATE findings from transitive dependencies (e.g. supabase-csharp) are not merge-blockers
       per policy; this prevents TreatWarningsAsErrors from promoting them to errors. -->
  <PropertyGroup>
    <NuGetAuditLevel>high</NuGetAuditLevel>
  </PropertyGroup>

  <!-- ── Code Analysis ── -->
  <!-- AnalysisLevel=latest-recommended: balanced ruleset, avoids excessive noise on first pass. -->
  <!-- EnforceCodeStyleInBuild: ensures .editorconfig style rules fire at build time, not just in IDE. -->
  <!-- TreatWarningsAsErrors is intentionally NOT set globally here; each project owns its own list. -->
  <!-- TreatWarningsAsErrors: zero-warning policy — all analyzer/compiler warnings become build errors. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- ── Shared Analyzer Packages ── -->
  <!-- PrivateAssets="all" keeps these as build-only tools; they don't become transitive dependencies. -->
  <!-- Condition excludes the legacy SSDT .sqlproj which uses ToolsVersion 4.0 and cannot consume these. -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <!-- License: MIT — free open-source (Microsoft / dotnet/roslyn-analyzers); no commercial restrictions. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.300">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: Sonar Source-Available License v1.0 — free to use as a build-time analyzer in your own product;
         restricts use in tools that compete with SonarQube. NOT an OSI-approved open-source license.
         Not a paid/commercial license — no subscription required for this NuGet package. -->
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.27.0.140913">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: MIT — free open-source (Gérald Barré / meziantou); no commercial restrictions. -->
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.101">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: Apache-2.0 — free open-source (dotnet/roslynator); no commercial restrictions. -->
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: Apache-2.0 — free open-source (Semih Okur / semihokur/AsyncFixer); no commercial restrictions. -->
    <PackageReference Include="AsyncFixer" Version="2.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: MIT — free open-source (Microsoft / dotnet/roslyn); no commercial restrictions.
         Note: 4.14.0 is the NuGet-latest but was unlisted by the owner (possible deprecation); pinned to 3.3.4. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: MIT — free open-source (Microsoft / dotnet/vs-threading); no commercial restrictions.
         Catches async deadlock patterns (VSTHRD002 .Result/.Wait(), VSTHRD003 foreign tasks,
         VSTHRD100 async void, VSTHRD110 fire-and-forget, VSTHRD200 missing Async suffix)
         that complement AsyncFixer's 6 rules. -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- License: MIT — free open-source (Tom Englert); no commercial restrictions.
         Flags every use of the null-forgiving operator (!) as a warning, enforcing that
         nullability suppressions are explicit suppressions rather than compiler silencing. -->
    <PackageReference Include="Nullable.Extended.Analyzer" Version="1.15.6581">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
